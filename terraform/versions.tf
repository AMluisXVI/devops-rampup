terraform {
  # >= 1.10 for native S3 state locking (use_lockfile); >= 1.11 for write-only
  # arguments, so the DB password never lands in the state
  required_version = ">= 1.11"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.5"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.7"
    }
  }
}
